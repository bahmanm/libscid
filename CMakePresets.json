{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "description": "Release build for libscid.",
      "binaryDir": "${sourceDir}/_build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "BUILD_SHARED_LIBS": "ON",
        "LIBSCID_INSTALL": "ON"
      }
    },
    {
      "name": "analysis",
      "displayName": "Analysis",
      "description": "Build tree for local static analysis tools.",
      "binaryDir": "${sourceDir}/_build/analysis",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "OFF",
        "LIBSCID_INSTALL": "OFF"
      }
    },
    {
      "name": "package",
      "displayName": "Package",
      "description": "Release build configured for portable SDK archive packaging.",
      "binaryDir": "${sourceDir}/_build/package",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "BUILD_SHARED_LIBS": "ON",
        "LIBSCID_INSTALL": "ON",
        "LIBSCID_BUILD_DOCS": "ON"
      }
    },
    {
      "name": "docs",
      "displayName": "Documentation",
      "description": "Build generated API documentation.",
      "binaryDir": "${sourceDir}/_build/docs",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "LIBSCID_BUILD_DOCS": "ON",
        "LIBSCID_INSTALL": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "cppcheck",
      "configurePreset": "analysis",
      "targets": [
        "cppcheck"
      ]
    },
    {
      "name": "package",
      "configurePreset": "package"
    },
    {
      "name": "docs",
      "configurePreset": "docs",
      "targets": [
        "api-docs"
      ]
    }
  ],
  "packagePresets": [
    {
      "name": "portable-tgz",
      "displayName": "Portable TGZ",
      "description": "Creates a portable libscid .tar.gz archive.",
      "configurePreset": "package",
      "generators": [
        "TGZ"
      ]
    }
  ]
}
