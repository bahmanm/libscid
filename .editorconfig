root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
tab_width = 4
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 100

[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 100

[{Makefile,*.mk}]
indent_style = tab
