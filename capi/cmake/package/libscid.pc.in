prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@LIBSCID_PC_LIBDIR@
includedir=@LIBSCID_PC_INCLUDEDIR@

Name: libscid
Description: Chess library for managing databases, from multi-terabyte collections to individual games
URL: https://github.com/bahmanm/libscid
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lscid
Cflags: @LIBSCID_PC_CFLAGS@
